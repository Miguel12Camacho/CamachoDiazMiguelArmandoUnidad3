# Copia este archivo como .env y configura tus propios valores.
# Nunca publiques secretos reales en GitHub.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tienda_digital
DB_USER=postgres
DB_PASSWORD=
# Para PostgreSQL administrado en la nube, normalmente se requiere SSL.
DB_SSL=false

# Servicio externo opcional de correo para recuperar contraseña.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Tienda Digital <no-reply@example.com>"
